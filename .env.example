# IAschool — variáveis locais
#
# Este e um modelo de referencia; preencha os valores somente no ambiente local.
# Nunca versione arquivos `.env` nem inclua valores reais de chaves neste arquivo.
#
# Para a interface, use as variaveis da primeira secao em
# artifacts/iaschool-app/.env. A API nao carrega .env sozinha: exporte as variaveis
# da segunda secao no terminal, use direnv ou outra ferramenta local equivalente.

# -----------------------------------------------------------------------------
# Interface web (Vite)
# -----------------------------------------------------------------------------
# Porta local da interface. Use outra porta se ela já estiver ocupada.
PORT=5174
BASE_PATH=/

# Projeto Supabase — valores públicos que podem ser consumidos pelo browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# API Express (use PORT=5000 ao iniciar a API, não a mesma porta da interface)
# -----------------------------------------------------------------------------
# A API aceita estas variáveis e dá preferência a elas em vez de VITE_*.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Somente servidor. Nunca prefixe com VITE_ nem use no browser.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# Senha do Postgres. Nenhum codigo do repo le esta variavel; serve para acesso
# manual (psql, Supabase CLI, ferramenta de SQL).
SUPABASE_DB_PASSWORD=

# -----------------------------------------------------------------------------
# Ajustes opcionais da API
# -----------------------------------------------------------------------------
GENERATION_DAILY_QUOTA=50
GENERATION_QUOTA_OUTAGE_THRESHOLD=3
LOG_LEVEL=info

# NAO USE. `lib/db` e um pacote Drizzle inerte: `lib/db/src/schema/index.ts` e um
# stub vazio e nao representa nenhuma tabela do IAschool. Rodar
# `pnpm --filter @workspace/db run push` apontaria o drizzle-kit para esta URL
# tentando alinhar o banco real a um schema vazio.
# O schema muda por `apply_migration` do MCP supabase-iaschool. Ver AGENTS.md.
DATABASE_URL=

# Personal Access Token do Supabase (Dashboard > Account > Access Tokens).
# Usado apenas pelo servidor MCP declarado em .mcp.json.
SUPABASE_ACCESS_TOKEN=
