{
  "name": "@workspace/ingest-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Worker que consome photo_jobs (kind=ingest): dimensões, EXIF de reserva e miniatura WebP 320px das fotos de evento.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "exif-reader": "^2.0.0",
    "pino": "^9.14.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:",
    "vitest": "^4.1.10"
  }
}
