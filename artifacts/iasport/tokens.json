        "$value": "#39ff14",
        "$description": "Verde neon da marca — cor de destaque das iniciais IA."
      },
      "primaryForeground": { "$value": "#12210d" },
      "secondary": {
        "$value": "#7e8a97",
        "$description": "Cinza azulado da marca."
      },
      "secondaryForeground": { "$value": "#14181c" },
      "muted": { "$value": "#333333" },
      "mutedForeground": { "$value": "#9aa4ae" },
      "accent": { "$value": "#22391b" },
      "accentForeground": { "$value": "#a4f78f" },
      "destructive": { "$value": "#ef4444" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#414141" },
      "ring": { "$value": "#39ff14" },
      "chart1": { "$value": "#39ff14" },
      "chart2": { "$value": "#7e8a97" },
      "chart3": { "$value": "#1fb903" },
      "chart4": { "$value": "#c3ccd4" },
      "chart5": { "$value": "#87f56d" },
      "sidebar": { "$value": "#141414" },
      "sidebarForeground": { "$value": "#e8ebee" },
      "sidebarBorder": { "$value": "#2c2c2c" },
      "sidebarPrimary": { "$value": "#39ff14" },
      "sidebarPrimaryForeground": { "$value": "#12210d" },
      "sidebarAccent": { "$value": "#262626" },
      "sidebarAccentForeground": { "$value": "#e8ebee" },
      "sidebarRing": { "$value": "#39ff14" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Prometo", "DM Sans", "sans-serif"],
        "$description": "Prometo — tipografia oficial da marca (arquivos enviados pelo usuário, embutidos via @font-face)."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["JetBrains Mono", "Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.5rem",
      "$description": "Raio base; sm/md/lg/xl derivam deste valor."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": { "$value": "0.25rem" }
  }
}
