{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Tokens da marca IAsport (fonte única da verdade). Paleta oficial: cinza escuro #2e2e2e, cinza azulado #7e8a97 e verde neon #39ff14. Modo escuro é o padrão da marca; modo claro disponível. Edite apenas este arquivo — src/index.css e src/generated/tokens.tsx são gerados por scripts/build-tokens.mjs.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f7f8f9" },
      "foreground": { "$value": "#2e2e2e" },
      "border": { "$value": "#dde1e6" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#2e2e2e" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#2e2e2e" },
      "primary": {
        "$value": "#39ff14",
        "$description": "Verde neon da marca — cor de destaque das iniciais IA."
      },
      "primaryForeground": { "$value": "#12210d" },
      "secondary": {
        "$value": "#7e8a97",
        "$description": "Cinza azulado da marca."
      },
      "secondaryForeground": { "$value": "#ffffff" },
      "muted": { "$value": "#eef0f3" },
      "mutedForeground": { "$value": "#67727e" },
      "accent": { "$value": "#e4fbdd" },
      "accentForeground": { "$value": "#186007" },
      "destructive": { "$value": "#dc2626" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#d4d9df" },
      "ring": { "$value": "#22b30b" },
      "chart1": { "$value": "#2fd611" },
      "chart2": { "$value": "#7e8a97" },
      "chart3": { "$value": "#188a06" },
      "chart4": { "$value": "#4b545e" },
      "chart5": { "$value": "#a9e59c" },
      "sidebar": { "$value": "#ffffff" },
      "sidebarForeground": { "$value": "#2e2e2e" },
      "sidebarBorder": { "$value": "#dde1e6" },
      "sidebarPrimary": { "$value": "#39ff14" },
      "sidebarPrimaryForeground": { "$value": "#12210d" },
      "sidebarAccent": { "$value": "#eef0f3" },
      "sidebarAccentForeground": { "$value": "#2e2e2e" },
      "sidebarRing": { "$value": "#22b30b" }
    },
    "dark": {
      "background": { "$value": "#1c1c1c" },
      "foreground": { "$value": "#f2f4f5" },
      "border": { "$value": "#3a3a3a" },
      "card": { "$value": "#2e2e2e" },
      "cardForeground": { "$value": "#f2f4f5" },
      "popover": { "$value": "#262626" },
      "popoverForeground": { "$value": "#f2f4f5" },
