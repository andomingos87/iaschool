{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "iaschool-app",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "BASE_PATH=/",
        "pnpm",
        "--filter",
        "@workspace/iaschool-app",
        "run",
        "dev"
      ],
      "port": 5174,
      "autoPort": true
    },
    {
      "name": "iaschool-app-demo",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "BASE_PATH=/",
        "VITE_SUPABASE_URL=",
        "VITE_SUPABASE_ANON_KEY=",
        "pnpm",
        "--filter",
        "@workspace/iaschool-app",
        "run",
        "dev"
      ],
      "port": 5175,
      "autoPort": true
    }
  ]
}