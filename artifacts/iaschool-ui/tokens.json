{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Tokens da marca IAschool (fonte única da verdade). Paleta fria: azul como cor principal, vermelho como destaque e branco nas superfícies claras. Modo escuro é o padrão; modo claro disponível. Edite apenas este arquivo — src/index.css e src/generated/tokens.tsx são gerados por scripts/build-tokens.mjs.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f8fafc" },
      "foreground": { "$value": "#0f2747" },
      "border": { "$value": "#d9e2f0" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#0f2747" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#0f2747" },
      "primary": {
        "$value": "#2563eb",
        "$description": "Azul IAschool — cor principal de ação e navegação."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": {
        "$value": "#e7eef9",
        "$description": "Azul claro para superfícies secundárias."
      },
      "secondaryForeground": { "$value": "#183b68" },
      "muted": { "$value": "#eef3fa" },
      "mutedForeground": { "$value": "#5d718d" },
      "accent": { "$value": "#e8efff" },
      "accentForeground": { "$value": "#1e4fb3" },
      "destructive": { "$value": "#be123c" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#c9d7ea" },
      "ring": { "$value": "#2563eb" },
      "chart1": { "$value": "#2563eb" },
      "chart2": { "$value": "#be123c" },
      "chart3": { "$value": "#0f8acb" },
      "chart4": { "$value": "#24466f" },
      "chart5": { "$value": "#93c5fd" },
      "sidebar": { "$value": "#ffffff" },
      "sidebarForeground": { "$value": "#0f2747" },
      "sidebarBorder": { "$value": "#d9e2f0" },
      "sidebarPrimary": { "$value": "#2563eb" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#eef3fa" },
      "sidebarAccentForeground": { "$value": "#0f2747" },
      "sidebarRing": { "$value": "#2563eb" }
    },
    "dark": {
      "background": { "$value": "#071426" },
      "foreground": { "$value": "#edf4ff" },
      "border": { "$value": "#19365b" },
      "card": { "$value": "#0c203b" },
      "cardForeground": { "$value": "#edf4ff" },
      "popover": { "$value": "#102744" },
      "popoverForeground": { "$value": "#edf4ff" },
      "primary": {
        "$value": "#60a5fa",
        "$description": "Azul claro IAschool para ações no modo escuro."
      },
      "primaryForeground": { "$value": "#071426" },
      "secondary": {
        "$value": "#193b66",
        "$description": "Azul de superfície secundária no modo escuro."
      },
      "secondaryForeground": { "$value": "#dbeafe" },
      "muted": { "$value": "#132d4e" },
      "mutedForeground": { "$value": "#9db1cc" },
      "accent": { "$value": "#163967" },
      "accentForeground": { "$value": "#dbeafe" },
      "destructive": { "$value": "#fb7185" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#23466f" },
      "ring": { "$value": "#60a5fa" },
      "chart1": { "$value": "#60a5fa" },
      "chart2": { "$value": "#fb7185" },
      "chart3": { "$value": "#22b8e8" },
      "chart4": { "$value": "#b9d5fb" },
      "chart5": { "$value": "#1d4ed8" },
      "sidebar": { "$value": "#08192f" },
      "sidebarForeground": { "$value": "#e4efff" },
      "sidebarBorder": { "$value": "#173454" },
      "sidebarPrimary": { "$value": "#60a5fa" },
      "sidebarPrimaryForeground": { "$value": "#071426" },
      "sidebarAccent": { "$value": "#102744" },
      "sidebarAccentForeground": { "$value": "#e4efff" },
      "sidebarRing": { "$value": "#60a5fa" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"],
        "$description": "Tipografia neutra e legível para a identidade inicial do IAschool."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["JetBrains Mono", "Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.5rem",
      "$description": "Raio base; sm/md/lg/xl derivam deste valor."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": { "$value": "0.25rem" }
  }
}
